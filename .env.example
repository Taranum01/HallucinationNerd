# OpenAI API key for the LLM judge
OPENAI_API_KEY=your-key-here

# Optional: Semantic Scholar API key (100 req/sec vs 1 req/sec without)
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional: Unpaywall requires a real email for their free tier
# The default in code (hallucinationnerd@example.com) is a placeholder; replace
# with a real email for production use to avoid rate limits.
UNPAYWALL_EMAIL=your-real-email@example.com

# Optional: web server bind (defaults to 127.0.0.1 for safety)
# Set to 0.0.0.0 to expose publicly (e.g., behind a reverse proxy)
HOST=127.0.0.1
PORT=8000

# Optional: model override (default gpt-4o)
VERIFICATION_MODEL=gpt-4o
